# ─────────────────────────────────────────────────────
# .env.example  —  Copy this file to .env and fill in your keys.
#                  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────

# Groq API key (free tier available at https://console.groq.com)
# Used for all LLM calls: routing, planning, query expansion, answering.
GROQ_API_KEY=your_groq_api_key_here

# ── Optional — LangSmith Observability ────────────────

# LangSmith API key (https://smith.langchain.com)
# Enable this to trace every LangGraph node's input, output, and latency
# in the LangSmith dashboard. Toggle live via the sidebar without restarting.
LANGCHAIN_API_KEY=your_langsmith_api_key_here

# Whether to enable LangSmith tracing on startup.
# Can also be toggled live in the Streamlit sidebar.
LANGCHAIN_TRACING_V2=false

# The LangSmith project name traces will be grouped under.
LANGCHAIN_PROJECT=Agentic_RAG_System

# ── Optional — Retrieval ──────────────────────────────

# Force-enable the cross-encoder reranker regardless of hardware.
# By default, reranking is enabled only when a GPU/MPS is available.
# Can also be toggled live in the Streamlit sidebar.
# ENABLE_RERANKER=false

# ── Optional — Redis Cache ────────────────────────────
# Redis URL for response caching. If Redis is unavailable, caching is
# silently disabled and the system operates normally.
# REDIS_URL=redis://localhost:6379
# CACHE_ENABLED=true
